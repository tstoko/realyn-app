rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Disputes collection
    // Allow public read access for the dashboard
    // Cloud Functions using admin SDK automatically bypass rules for writes
    match /disputes/{disputeId} {
      allow read: if true;
      // Writes are handled by Cloud Functions with admin privileges
      // No client-side writes needed for now
    }
    
    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

