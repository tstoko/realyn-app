rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Uses custom claims set by the syncUserClaims Cloud Function.
    // Admins can read any org; regular users can only read their own.
    function userCanReadOrg(orgId) {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.orgId == orgId
      );
    }

    // =========================================================================
    // Disputes Collection
    // =========================================================================
    // Reads scoped by organization via custom claims.
    // Writes handled exclusively by Cloud Functions (admin SDK).
    match /disputes/{disputeId} {
      allow read: if isAuthenticated()
                  && resource.data.organizationId != null
                  && userCanReadOrg(resource.data.organizationId);
      allow write: if false;

      // Evidence subcollection — inherits parent dispute's org scope
      match /evidence/{evidenceId} {
        allow read: if isAuthenticated()
                    && get(/databases/$(database)/documents/disputes/$(disputeId)).data.organizationId != null
                    && userCanReadOrg(get(/databases/$(database)/documents/disputes/$(disputeId)).data.organizationId);
        allow write: if false;
      }

      // Tasks subcollection — inherits parent dispute's org scope
      match /tasks/{taskId} {
        allow read: if isAuthenticated()
                    && get(/databases/$(database)/documents/disputes/$(disputeId)).data.organizationId != null
                    && userCanReadOrg(get(/databases/$(database)/documents/disputes/$(disputeId)).data.organizationId);
        allow write: if false;
      }
    }

    // =========================================================================
    // Organizations Collection
    // =========================================================================
    // Reads scoped by org path parameter via custom claims.
    // Writes handled by Cloud Functions with admin SDK.
    match /organizations/{orgId} {
      allow read: if userCanReadOrg(orgId);
      allow write: if false;

      match /pmsImports/{importId} {
        allow read: if userCanReadOrg(orgId);
        allow write: if false;
      }

      match /pmsReservations/{resId} {
        allow read: if userCanReadOrg(orgId);
        allow write: if false;
      }

      match /auditLog/{logId} {
        allow read: if userCanReadOrg(orgId);
        allow write: if false;
      }

    }

    // =========================================================================
    // Users Collection
    // =========================================================================
    // Users can read their own document only. Writes go through Cloud Functions.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // =========================================================================
    // Dispute History (Archive)
    // =========================================================================
    match /disputes_history/{disputeId} {
      allow read: if isAuthenticated()
                  && resource.data.organizationId != null
                  && userCanReadOrg(resource.data.organizationId);
      allow write: if false;
    }

    // =========================================================================
    // Operations Collection (long-running jobs)
    // =========================================================================
    match /operations/{operationId} {
      allow read: if isAuthenticated()
                  && resource.data.organizationId != null
                  && userCanReadOrg(resource.data.organizationId);
      allow write: if false;
    }

    // =========================================================================
    // Rulesets Collection (versioned scheme rules)
    // =========================================================================
    match /rulesets/{rulesetId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /rules/{ruleId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // =========================================================================
    // Knowledge Base Collections (read-only for authenticated users)
    // Writes handled exclusively by Cloud Functions (admin SDK / seed handlers).
    // =========================================================================
    match /schemeRules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /evidenceRequirements/{reqId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /pspFormats/{formatId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /evidenceOutputTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // winPatterns documents are shared, anonymised, cross-tenant statistics
    // keyed by `{network}_{reasonCode}_{verticalId}`. They MUST NOT carry
    // `organizationId`, file names, customer text, or any other tenant-
    // identifying field — only category strings, paragraph headings, and
    // counters. See docs/post-hardening-plan.md §B2 for the full rationale.
    // If a future change adds per-tenant data to this collection, change
    // this rule to filter on `organizationId` (mirroring `disputes`) AND
    // backfill the field on every existing doc.
    match /winPatterns/{patternId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // =========================================================================
    // Webhook Idempotency (internal — no client access)
    // =========================================================================
    match /_processedWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // =========================================================================
    // Rate Limiting (internal — no client access)
    // =========================================================================
    match /_rateLimits/{docId} {
      allow read, write: if false;
    }

    // =========================================================================
    // Unmatched Webhook Events (internal — no client access)
    // =========================================================================
    match /unmatchedWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // =========================================================================
    // Default: deny all other access
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
