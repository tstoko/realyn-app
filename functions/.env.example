# Copy to .env for local Functions / emulator (never commit real secrets).
# Gen2 deployed functions: set secrets with `firebase functions:secrets:set <NAME>`
# and set non-secret env (like DASHBOARD_URL) on each Cloud Run service
# (or use GCP console → Cloud Functions → edit → Variables).

# --- Email ---------------------------------------------------------------
RESEND_API_KEY=
DASHBOARD_URL=https://dashboard.realyn.app

# --- RAG (Pinecone) ------------------------------------------------------
# Bind `PINECONE_API_KEY` on any function or script that touches Pinecone
# (retrieval handlers, ingestion scripts). Create via:
#   firebase functions:secrets:set PINECONE_API_KEY
PINECONE_API_KEY=
# Optional override — defaults to `realyn-rag`. Use distinct names per
# environment (e.g. `realyn-rag-staging`) so staging ingestion cannot
# accidentally write into the production index.
PINECONE_INDEX_NAME=realyn-rag
