# Copy to .env for local Functions / emulator (never commit real secrets).
# Gen2 deployed functions: set secrets with `firebase functions:secrets:set <NAME>`
# and set non-secret env (like DASHBOARD_URL) on each Cloud Run service
# (or use GCP console → Cloud Functions → edit → Variables).

# --- Email ---------------------------------------------------------------
RESEND_API_KEY=
DASHBOARD_URL=https://dashboard.realyn.app

# --- RAG (Pinecone) ------------------------------------------------------
# Bind `PINECONE_API_KEY` on any function or script that touches Pinecone
# (retrieval handlers, ingestion scripts). Create via:
#   firebase functions:secrets:set PINECONE_API_KEY
PINECONE_API_KEY=
# Optional override — defaults to `realyn-rag`. Use distinct names per
# environment (e.g. `realyn-rag-staging`) so staging ingestion cannot
# accidentally write into the production index.
PINECONE_INDEX_NAME=realyn-rag
# Optional cloud + region overrides for the Pinecone serverless index.
# Defaults: aws / us-east-1 — the only combination supported by the
# Pinecone Starter (free) plan. To co-locate the index with Cloud Functions
# (lower retrieval latency) on a paid plan, set:
#   PINECONE_CLOUD=gcp
#   PINECONE_REGION=us-central1
# These take effect at index creation time. Pinecone serverless cloud +
# region are immutable on an existing index, so changing them after
# rag:setup has run requires a new PINECONE_INDEX_NAME and re-ingestion.
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# --- AI (LLM provider) ---------------------------------------------------
# The LLM service routes through an `LlmProvider` abstraction
# (packages/ai-core/src/services/llm/). The active provider is chosen
# at runtime via `LLM_PROVIDER`. Default: `openai`. Valid values:
# `openai`, `anthropic`. Set this on each Cloud Run service that runs
# AI pipeline code (e.g. `onEvidencePlanQueued`, `draftArgument`,
# `seedDemoData`) — no redeploy required to flip providers because
# both API keys are bound as secrets on those functions.
# LLM_PROVIDER=openai

# --- AI (OpenAI) ---------------------------------------------------------
# Bound on Gen2 functions that call OpenAI. Required when
# LLM_PROVIDER=openai. Set via:
#   firebase functions:secrets:set OPENAI_API_KEY
OPENAI_API_KEY=
# Optional override — defaults to `gpt-5.5`. If that exact model
# identifier isn't accepted by the OpenAI API on your account, set
# this to a model your account does accept (e.g. `gpt-4o`).
# OPENAI_MODEL=gpt-5.5

# --- AI (Anthropic) ------------------------------------------------------
# Bound on Gen2 functions that call Claude. Required when
# LLM_PROVIDER=anthropic. Set via:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=
# Optional override — defaults to `claude-opus-4-6`.
# ANTHROPIC_MODEL=claude-opus-4-6

# --- Stripe (PSP disputes + webhooks) ------------------------------------
# Used by `stripeWebhook` and dispute sync paths.
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Stripe (billing / subscriptions) -----------------------------------
# Used by `createCheckoutSession`, `billingWebhook`, `createBillingPortalSession`.
#   firebase functions:secrets:set STRIPE_BILLING_SECRET_KEY
#   firebase functions:secrets:set STRIPE_BILLING_WEBHOOK_SECRET
STRIPE_BILLING_SECRET_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=

# --- Data retention (optional) -------------------------------------------
# Days before terminal disputes are anonymized (default 730). Non-secret.
# DATA_RETENTION_DAYS=730
