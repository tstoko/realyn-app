# Project-specific runtime env vars for the `realyn-app` (production) project.
#
# Firebase CLI auto-loads `functions/.env.<project_id>` at deploy time and
# bundles its non-secret variables as Cloud Run env vars on every deployed
# function. See https://firebase.google.com/docs/functions/config-env
#
# Secrets (PINECONE_API_KEY, ANTHROPIC_API_KEY, STRIPE_*) belong in Google
# Secret Manager via `firebase functions:secrets:set <NAME>`, NOT here.
#
# Non-secret values that vary per environment go in this file.

# --- RAG (Pinecone) ------------------------------------------------------
# The only currently-populated index is `realyn-rag-dev` (2284 vectors:
# Visa Public Rules + Mastercard Chargeback Guide Merchant Edition).
# Production points at it until a dedicated `realyn-rag` (or
# `realyn-rag-prod`) index is provisioned and ingested.
PINECONE_INDEX_NAME=realyn-rag-dev
