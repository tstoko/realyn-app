{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "copy-firestore-to-emulator": "npm run build && CONFIRM_COPY=yes node lib/scripts/copyFirestoreProdToEmulator.js",
    "seed:dice": "npm run build && node lib/scripts/seedDiceDemo.js",
    "seed:dice:emulator": "npm run build && node --env-file=.env.emulator.seed lib/scripts/seedDiceDemo.js",
    "seed:nimax": "npm run build && node lib/scripts/seedNimaxDemo.js",
    "seed:nimax:emulator": "npm run build && node --env-file=.env.emulator.seed lib/scripts/seedNimaxDemo.js",
    "seed:zipworld": "npm run build && node lib/scripts/seedZipworldDemo.js",
    "seed:zipworld:emulator": "npm run build && node --env-file=.env.emulator.seed lib/scripts/seedZipworldDemo.js",
    "seed:skiddle": "npm run build && node lib/scripts/seedSkiddleDemo.js",
    "seed:skiddle:emulator": "npm run build && node --env-file=.env.emulator.seed lib/scripts/seedSkiddleDemo.js",
    "seed:sadlerswells": "npm run build && node lib/scripts/seedSadlersWellsDemo.js",
    "seed:sadlerswells:emulator": "npm run build && node --env-file=.env.emulator.seed lib/scripts/seedSadlersWellsDemo.js",
    "seed:attractionworld": "npm run build && node lib/scripts/seedAttractionworldDemo.js",
    "seed:attractionworld:emulator": "npm run build && node --env-file=.env.emulator.seed lib/scripts/seedAttractionworldDemo.js",
    "rag:setup": "npm run build && node --env-file=.env lib/scripts/setupPineconeIndex.js",
    "rag:ingest": "npm run build && node --env-file=.env lib/scripts/ingestRulebooks.js",
    "rag:test": "npm run build && node --env-file=.env lib/scripts/testRagRetrieval.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@adyen/api-library": "^30.1.0",
    "@anthropic-ai/sdk": "^0.91.1",
    "@pinecone-database/pinecone": "^7.2.0",
    "@realyn/ai-core": "file:../packages/ai-core",
    "axios": "^1.13.6",
    "csv-parse": "^6.1.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.4.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.0.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "raw-body": "^3.0.1",
    "resend": "^6.9.4",
    "stripe": "^14.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.5",
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.5.0"
  },
  "private": true,
  "overrides": {
    "protobufjs": "7.5.5"
  }
}
