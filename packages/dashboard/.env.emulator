# Copy to .env.local for local development against Firebase emulators:
#   npm run setup:dashboard:emulator
# Then add your Firebase web app keys from Firebase Console → Project settings (same project as production).

VITE_WEBSITE_URL=http://localhost:3001

# ---- REQUIRED: point the dashboard at local Functions + emulators ----
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_FUNCTIONS_URL=http://127.0.0.1:5001/realyn-app/us-central1

# ---- REQUIRED: MCP Server (handles AI evidence planning and argument generation) ----
# For local dev, run the MCP server separately: cd packages/mcp-server && npm run dev
VITE_MCP_SERVER_URL=http://localhost:3002

VITE_FIREBASE_PROJECT_ID=realyn-app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=realyn-app.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=realyn-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
