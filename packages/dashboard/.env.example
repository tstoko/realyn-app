# URL of the website app (for logout/unauthenticated redirect)
VITE_WEBSITE_URL=https://realyn.app

# Firebase auth domain (set to your custom domain for cross-subdomain auth)
# VITE_FIREBASE_AUTH_DOMAIN=realyn.app

# Environment
# VITE_ENVIRONMENT=production
# VITE_FIREBASE_FUNCTIONS_URL=https://us-central1-realyn-app.cloudfunctions.net
# VITE_FIREBASE_PROJECT_ID=realyn-app
# VITE_FIREBASE_REGION=us-central1
# VITE_DEMO_MODE=false
# VITE_DEBUG=false

# Firebase Emulators (set to "true" to use local emulators instead of production)
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_FIREBASE_FUNCTIONS_URL=http://127.0.0.1:5001/realyn-app/us-central1
