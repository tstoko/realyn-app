# URL of the website app (for logout/unauthenticated redirect)
VITE_WEBSITE_URL=https://realyn.app

# Firebase auth domain (set to your custom domain for cross-subdomain auth)
# VITE_FIREBASE_AUTH_DOMAIN=realyn.app

# ---- REQUIRED: Firebase Configuration ----
# These are required -- the app will fail to start without them.
VITE_FIREBASE_FUNCTIONS_URL=https://us-central1-realyn-app.cloudfunctions.net
# Demo Auth users (DICE, Nimax, Zip World, Skiddle) exist only in the Firebase project you seed.
# Match this ID to `firebase use` / ADC when running `npm run seed:*` from the repo root.
VITE_FIREBASE_PROJECT_ID=realyn-app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=realyn-app.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=realyn-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Billing (Stripe Checkout price IDs from Stripe Dashboard) ----
# Required for /billing plan selection; see packages/shared/src/billing.ts
# VITE_STRIPE_PRICE_STARTER_MONTHLY=price_...
# VITE_STRIPE_PRICE_STARTER_YEARLY=price_...
# VITE_STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
# VITE_STRIPE_PRICE_PROFESSIONAL_YEARLY=price_...

# ---- Optional ----
# VITE_ENVIRONMENT=production
# VITE_FIREBASE_REGION=us-central1
# VITE_DEMO_MODE=false
# VITE_DEBUG=false

# ---- CI/CD (GitHub Actions) ----
# Production dashboard deploy: set DASHBOARD_VITE_* secrets listed in .github/workflows/deploy-dashboard.yml
# Staging: set STAGING_VITE_* secrets in .github/workflows/deploy-staging.yml

# ---- Firebase Emulators (localhost) ----
# Quick setup: copy packages/dashboard/.env.emulator → .env.local
#   npm run setup:dashboard:emulator
# Then fill VITE_FIREBASE_API_KEY, MESSAGING_SENDER_ID, APP_ID from Firebase Console.
# These two MUST be set together. If VITE_USE_FIREBASE_EMULATORS is true but
# VITE_FIREBASE_FUNCTIONS_URL still points at production, authenticated requests
# will fail (emulator tokens are rejected by the production Admin SDK).
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_FIREBASE_FUNCTIONS_URL=http://127.0.0.1:5001/realyn-app/us-central1
