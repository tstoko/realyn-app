# Staging environment — points to realyn-app-staging Firebase project
# Fill in values after creating the staging project in Firebase Console

VITE_WEBSITE_URL=https://realyn-app-staging.web.app

# Firebase config for staging project (replace with actual values)
VITE_FIREBASE_API_KEY=YOUR_STAGING_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=realyn-app-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=realyn-app-staging
VITE_FIREBASE_STORAGE_BUCKET=realyn-app-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_STAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_STAGING_APP_ID
VITE_FIREBASE_FUNCTIONS_URL=https://us-central1-realyn-app-staging.cloudfunctions.net
VITE_FIREBASE_REGION=us-central1
VITE_ENVIRONMENT=staging
