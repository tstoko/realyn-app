# =============================================================================
# Environment Configuration Template
# =============================================================================
# Copy this file to .env.local for local development
# DO NOT commit .env files with actual values to version control
# =============================================================================

# Environment identifier (production | staging | development)
VITE_ENVIRONMENT=development

# =============================================================================
# Firebase Configuration
# =============================================================================

# Firebase Functions base URL
# Production: https://us-central1-realyn-app.cloudfunctions.net
# Local emulator: http://127.0.0.1:5001/realyn-app/us-central1
VITE_FIREBASE_FUNCTIONS_URL=https://us-central1-realyn-app.cloudfunctions.net

# Firebase project ID
VITE_FIREBASE_PROJECT_ID=realyn-app

# Firebase region
VITE_FIREBASE_REGION=us-central1

# =============================================================================
# Feature Flags
# =============================================================================

# Enable demo mode (shows demo data banner)
VITE_DEMO_MODE=false

# Enable debug logging
VITE_DEBUG=false

# =============================================================================
# Firebase Client SDK Configuration (if not using firebase.js)
# =============================================================================

# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
