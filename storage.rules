rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper: check if user belongs to the given organization (or is admin)
    function userBelongsToOrg(orgId) {
      let userData = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return userData.organizationId == orgId || userData.role == 'admin';
    }

    // Evidence files stored under: organizations/{orgId}/disputes/{disputeId}/evidence/{category}/{filename}
    match /organizations/{orgId}/disputes/{disputeId}/evidence/{allPaths=**} {
      allow read: if request.auth != null
                  && userBelongsToOrg(orgId);
      
      allow write: if request.auth != null
                   && userBelongsToOrg(orgId)
                   && request.resource.size < 10 * 1024 * 1024  // 10MB max file size
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('application/.*pdf.*')
                       || request.resource.contentType.matches('text/.*')
                       || request.resource.contentType == 'application/octet-stream');
      
      allow delete: if request.auth != null
                    && userBelongsToOrg(orgId);
    }
    
    // Legacy path support: evidence/{disputeId}/{filename}
    // Kept permissive since legacy paths don't encode orgId; restrict to auth only
    match /evidence/{disputeId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('application/.*pdf.*')
                       || request.resource.contentType.matches('text/.*')
                       || request.resource.contentType == 'application/octet-stream');
      
      allow delete: if request.auth != null;
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
