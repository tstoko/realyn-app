rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Uses custom claims set by syncUserClaims Cloud Function.
    // Admins can access any org; regular users only their own.
    function userBelongsToOrg(orgId) {
      return request.auth.token.role == 'admin'
          || request.auth.token.orgId == orgId;
    }

    // Evidence files stored under: organizations/{orgId}/disputes/{disputeId}/evidence/{category}/{filename}
    match /organizations/{orgId}/disputes/{disputeId}/evidence/{allPaths=**} {
      allow read: if request.auth != null
                  && userBelongsToOrg(orgId);
      
      allow write: if request.auth != null
                   && userBelongsToOrg(orgId)
                   && request.resource.size < 10 * 1024 * 1024  // 10MB max file size
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('application/.*pdf.*')
                       || request.resource.contentType.matches('text/.*')
                       || request.resource.contentType == 'application/octet-stream');
      
      allow delete: if request.auth != null
                    && userBelongsToOrg(orgId);
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
