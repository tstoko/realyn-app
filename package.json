{
  "name": "realyn-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "build:website": "turbo build --filter=@realyn/website",
    "build:dashboard": "turbo build --filter=@realyn/dashboard",
    "dev:website": "turbo dev --filter=@realyn/website",
    "dev:dashboard": "turbo dev --filter=@realyn/dashboard"
  },
  "packageManager": "npm@11.6.2",
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "tailwindcss": "^3.4.19",
    "turbo": "^2"
  }
}
