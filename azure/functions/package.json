{
  "name": "realyn-azure-functions",
  "version": "1.0.0",
  "description": "Azure Functions backend for Realyn App",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "npm run build && func start",
    "prestart": "npm run build",
    "deploy": "npm run build && func azure functionapp publish $(cat ../.azure-config | grep FUNCTION_APP_NAME | cut -d= -f2)"
  },
  "dependencies": {
    "@azure/cosmos": "^4.0.0",
    "@azure/keyvault-secrets": "^4.8.0",
    "@azure/identity": "^4.2.0",
    "@azure/storage-blob": "^12.17.0",
    "openai": "^4.28.0",
    "stripe": "^14.14.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@azure/functions": "^4.3.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
